# ---------------------------------------------------------------------------
# AutoShorts configuration. Copy to `.env` — every value has a working default,
# so an empty file still produces a video (`autoshorts demo`).
# ---------------------------------------------------------------------------

# ===== Script writer ========================================================
# openai | anthropic | ollama | template   (template = free, offline, no key)
LLM_PROVIDER=template
LLM_MODEL=
LLM_TEMPERATURE=0.8

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ===== Voiceover ============================================================
# edge | openai | piper | sapi | espeak | say | silence
# edge = free Microsoft neural voices, no key, gives word timings (needs internet)
# sapi/espeak/say = offline system TTS, zero install beyond your OS
TTS_PROVIDER=edge
TTS_RATE=+8%            # edge only; relative speed, e.g. +12% or -5%
EDGE_VOICE=en-US-GuyNeural
OPENAI_TTS_VOICE=alloy
PIPER_VOICE=en_US-lessac-medium
PIPER_BIN=piper

# ===== B-roll (optional — procedural art is used when both are empty) ======
PEXELS_API_KEY=         # https://www.pexels.com/api/ (free)
PIXABAY_API_KEY=        # https://pixabay.com/api/docs/ (free)
STOCK_PRIORITY=pexels,pixabay,procedural
STOCK_ORIENTATION=portrait
DOWNLOAD_DIR=cache/media

# ===== Look & feel ==========================================================
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
TARGET_SECONDS=45
CAPTION_LANGUAGE=auto
CAPTION_FONT=Arial Black
CAPTION_HIGHLIGHT_COLOR=#FFE81A
CAPTION_BASE_COLOR=#FFFFFF
IMAGE_KEN_BURNS=true
CLIP_LOOK=natural       # natural | punchy | flat
MUSIC_FILE=
MUSIC_VOLUME=0.16       # 0 disables the music bed

# ===== Paths & plumbing =====================================================
OUTPUT_DIR=output
LOG_LEVEL=INFO
# Leave empty to auto-detect: PATH -> imageio-ffmpeg -> common install folders.
FFMPEG_BIN=
FFPROBE_BIN=
WHISPER_MODEL=small     # tiny | base | small | medium (only used if needed)
